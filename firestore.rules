rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isUser(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function onlyChangingMembers() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members']);
    }

    function isJoining() {
      return request.resource.data.members.hasAll(resource.data.members)
        && request.resource.data.members.size() == resource.data.members.size() + 1
        && request.auth.uid in request.resource.data.members
        && !(request.auth.uid in resource.data.members);
    }

    function isLeaving() {
      return resource.data.members.hasAll(request.resource.data.members)
        && request.resource.data.members.size() == resource.data.members.size() - 1
        && request.auth.uid in resource.data.members
        && !(request.auth.uid in request.resource.data.members);
    }

    match /users/{userId} {
      allow read: if true;
      allow create, update: if isUser(userId);
      allow delete: if isUser(userId) || (
        signedIn()
        && request.auth.token.email != null
        && resource.data.email is string
        && resource.data.email.lower() == request.auth.token.email.lower()
      );
    }

    match /teams/{teamId} {
      allow read: if true;

      allow create: if signedIn()
        && request.resource.data.creatorId == request.auth.uid
        && request.auth.uid in request.resource.data.members;

      allow delete: if signedIn() && resource.data.creatorId == request.auth.uid;

      allow update: if signedIn() && (
        resource.data.creatorId == request.auth.uid
        || (onlyChangingMembers() && (isJoining() || isLeaving()))
      );
    }
  }
}
